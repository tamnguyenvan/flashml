# --- Process ---
FLASHML_HOST=0.0.0.0
FLASHML_PORT=8000
FLASHML_LOG_LEVEL=INFO
FLASHML_JSON_LOGS=false
FLASHML_REQUIRE_CUDA=true
FLASHML_DEVICE=cuda
FLASHML_PRELOAD=true
FLASHML_INFERENCE_TIMEOUT_S=600

# Comma-separated list of accepted API keys sent via the X-API-Key header.
# Empty disables auth. /health and /ready stay public regardless.
FLASHML_API_KEYS=

# all  |  reconstruct  |  interactive-segment  |  segment  |  remove
FLASHML_ENABLED_ROUTES=all

# Set a URL to proxy that route instead of loading the model in-process.
FLASHML_RECONSTRUCT_URL=
FLASHML_INTERACTIVE_SEGMENT_URL=
FLASHML_SEGMENT_URL=
FLASHML_REMOVE_URL=

# --- Shared limits ---
FLASHML_MAX_UPLOAD_BYTES=26214400

# --- MoGe /reconstruct ---
FLASHML_MOGE_MODEL_REPO=Ruicheng/moge-3-vitg
FLASHML_MOGE_SOURCE_REPO=https://github.com/microsoft/MoGe.git
FLASHML_MOGE_SOURCE_REVISION=74fbce054ebed49800de42d0ad0e83495065719a
FLASHML_MOGE_ROOT=/workspace/flashml/third_party/MoGe

# --- SimpleClick /interactive-segment ---
FLASHML_SIMPLECLICK_ROOT=/workspace/flashml/third_party/SimpleClick
FLASHML_SIMPLECLICK_CHECKPOINT=/workspace/flashml/weights/simpleclick/cocolvis_vit_huge.pth

# --- OneFormer /segment ---
FLASHML_ONEFORMER_MODEL_ID=shi-labs/oneformer_ade20k_swin_large
FLASHML_ONEFORMER_MODEL_DIR=/workspace/flashml/weights/oneformer
HF_HOME=/workspace/flashml/weights/huggingface
OPENCV_IO_ENABLE_OPENEXR=1

# --- LaMa /remove ---
FLASHML_LAMA_MODEL_DIR=/workspace/flashml/weights/lama
FLASHML_LAMA_MAX_LONGEST_SIZE=1024
